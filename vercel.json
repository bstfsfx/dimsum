{
  "version": 2,
  "buildCommand": "cd client && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/content/[endpoint].js": {
      "maxDuration": 10
    }
  }
}
